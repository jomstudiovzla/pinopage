# ═══════════════════════════════════════════════════════════════
# Pino Espaces Verts — Configuration Apache / Hostinger (v3.0.0)
# ═══════════════════════════════════════════════════════════════

# 1. Encodage et fuseau
AddDefaultCharset UTF-8

# 2. Types MIME modernes (PWA, polices, webp)
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest .json
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>

# 3. Réécriture d'URL et HTTPS forcé
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirection HTTP vers HTTPS automatique
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Empêcher le listing des répertoires
  Options -Indexes

  # Ne pas réécrire les fichiers et répertoires existants
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Routeur SPA pour navigation directe
  RewriteRule ^ index.html [L]
</IfModule>

# 4. En-têtes de sécurité stricts (Conformes RGPD & OWASP)
<IfModule mod_headers.c>
  # Protection contre le reniflage de type MIME
  Header always set X-Content-Type-Options "nosniff"

  # Protection contre le détournement de clic (Clickjacking)
  Header always set X-Frame-Options "SAMEORIGIN"

  # Politique de référence
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Restrictions des fonctionnalités du navigateur
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"

  # HSTS (Strict-Transport-Security)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Politique de Sécurité du Contenu (CSP) autorisant Firebase, Google Auth, Maps et styles
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://www.gstatic.com https://apis.google.com https://accounts.google.com https://*.firebaseio.com https://*.firebasedatabase.app; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.firebaseio.com wss://*.firebaseio.com https://*.firebasedatabase.app wss://*.firebasedatabase.app https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com https://gmail.googleapis.com https://oauth2.googleapis.com https://api.web3forms.com https://formsubmit.co; frame-src 'self' https://pagepino-e8e97.firebaseapp.com https://accounts.google.com https://appleid.apple.com https://maps.google.com https://www.google.com; worker-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'self' https://formsubmit.co https://api.web3forms.com; object-src 'none'; frame-ancestors 'self'"

  # Mise en cache optimale des assets immuables
  <FilesMatch "\.(css|js|webp|png|jpg|jpeg|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Pas de cache pour index.html, sw.js et manifest.json pour garantir les mises à jour instantanées
  <FilesMatch "(index\.html|sw\.js|manifest\.json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>

# 5. Compression GZIP / Brotli
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# 6. Page 404 personnalisée
ErrorDocument 404 /404.html
