rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email_verified == true && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.email == 'pino.espacesverts@gmail.com' ||
        request.auth.token.email == 'pino.spacesverts@gmail.com' ||
        request.auth.token.email == 'jomstudiovzla@gmail.com'
      );
    }

    // 1. Pino Users: Authenticated users can read/write their own profiles; Admin can access all
    match /pino_users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // 2. Pino Sessions: Authenticated users log sessions; Owner and Admin can read
    match /pino_sessions/{sessionId} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 3. Coupons & Leads
    match /pino_coupons/{docId} {
      allow read: if request.auth != null && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // L5 — Firestore no se usa en v1 (los leads viven en Realtime Database). Se cierra el
    // 'create: if true' mundo-escribible para que, si algún día se habilita Firestore, no
    // quede una vía de spam abierta. Reabrir con validación explícita si se migra aquí.
    match /leads/{docId} {
      allow create: if request.auth != null
        && request.resource.data.keys().size() <= 30
        && (!('email' in request.resource.data) || request.resource.data.email is string);
      allow read, update, delete: if isAdmin();
    }

    // Default: Locked down (Politique de déni par défaut)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
