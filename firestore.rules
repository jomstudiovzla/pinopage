rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Pino Users: Authenticated users can read and write their profiles
    match /pino_users/{userId} {
      allow read, write: if request.auth != null;
    }

    // 2. Pino Sessions: Authenticated users log sessions; Admin can audit all
    match /pino_sessions/{sessionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.token.email == 'pino.spacesverts@gmail.com';
    }

    // 3. Coupons & Leads (Public landing page lead capture)
    match /pino_coupons/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && request.auth.token.email == 'pino.spacesverts@gmail.com';
    }

    match /leads/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && request.auth.token.email == 'pino.spacesverts@gmail.com';
    }

    // Default: Locked down
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.email == 'pino.spacesverts@gmail.com';
    }
  }
}
